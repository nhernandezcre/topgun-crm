# ----------------------------------------------------------------------------
# Should I Buy This? — environment
# Copy to .env.local and fill each section. Every key is explained below.
# ----------------------------------------------------------------------------

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Should I Buy This?"

# ============================================================================
# Anthropic (Claude)
# Get your key: https://console.anthropic.com/settings/keys
# Model is pinned in lib/claude.ts (claude-sonnet-4-5).
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# Supabase
# Create a project: https://supabase.com/dashboard/new
# Auth → Providers → Email → enable magic link.
# Run migrations in /supabase/migrations via the SQL editor.
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================================
# Stripe
# https://dashboard.stripe.com/apikeys
# Products to create:
#   - "Should I Buy This — Pro Monthly" at $4.99 / month  → STRIPE_PRICE_MONTHLY
#   - "Should I Buy This — Pro Annual"  at $29.00 / year  → STRIPE_PRICE_ANNUAL
# Webhook endpoint: POST {APP_URL}/api/stripe/webhook
# Subscribe to: checkout.session.completed, customer.subscription.updated,
#               customer.subscription.deleted, invoice.payment_failed
# ============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ============================================================================
# Price intelligence
# SerpAPI (Google Shopping): https://serpapi.com/manage-api-key
# Keepa (Amazon price history): https://keepa.com/#!api
# ============================================================================
SERPAPI_KEY=
KEEPA_API_KEY=

# ============================================================================
# Reddit
# Create an app: https://www.reddit.com/prefs/apps (type: script)
# REDDIT_USER_AGENT must be unique per Reddit rules.
# ============================================================================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="web:should-i-buy-this:v1.0 (by /u/YOUR_USERNAME)"

# ============================================================================
# Affiliate (revenue layer two)
# Amazon Associates: https://affiliate-program.amazon.com/ (your tracking id)
# Skimlinks: https://skimlinks.com/ (publisher id, optional fallback)
# Documented wiring: see lib/affiliate.ts.
# ============================================================================
AMAZON_ASSOCIATE_TAG=yourtag-20
SKIMLINKS_PUBLISHER_ID=

# ============================================================================
# Web push
# Generate a VAPID pair once:   npx web-push generate-vapid-keys
# ============================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ============================================================================
# Cron (Vercel Cron or a pinger). Used by /api/cron/price-check.
# ============================================================================
CRON_SECRET=pick-a-long-random-string
